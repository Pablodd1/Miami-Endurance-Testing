                <!-- Testimonial 3 -->
                <div class="testimonial-card">
                    <div class="testimonial-header">
                        <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=400" alt="Cyclist" class="testimonial-avatar">
                        <div class="testimonial-info">
                            <h4>David L.</h4>
                            <span class="athlete-type">Cyclist / Gran Fondo</span>
