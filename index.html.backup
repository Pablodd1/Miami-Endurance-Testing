            },
            {
              "@type": "Person",
              "name": "Scott",
              "jobTitle": "Co-Founder & Marketing Director",
              "description": "Endurance athlete and marketing specialist from Switzerland"
            }
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://miamiendurancetesting.com/#website",
          "url": "https://miamiendurancetesting.com",
          "name": "Miami Endurance Testing",
          "publisher": {
            "@id": "https://miamiendurancetesting.com/#organization"
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://miamiendurancetesting.com/?s={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "SportsActivityLocation",
          "@id": "https://miamiendurancetesting.com/#sportslocation",
          "name": "Miami Endurance Testing Laboratory",
          "description": "Scientific athletic performance testing facility specializing in lactate threshold analysis, sweat testing, and personalized endurance coaching using the Norwegian training method.",
          "url": "https://miamiendurancetesting.com",
          "telephone": "+1-305-555-TEST",
          "email": "info@miamiendurancetesting.com",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Miami",
            "addressRegion": "FL",
            "addressCountry": "US"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": "25.7617",
            "longitude": "-80.1918"
          },
          "openingHoursSpecification": [
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
              "opens": "06:00",
              "closes": "20:00"
            },
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Saturday"],
              "opens": "07:00",
              "closes": "14:00"
            }
          ],
          "priceRange": "$$",
          "currenciesAccepted": "USD",
          "paymentAccepted": "Cash, Credit Card, PayPal",
          "areaServed": {
            "@type": "GeoCircle",
            "geoMidpoint": {
              "@type": "GeoCoordinates",
              "latitude": "25.7617",
              "longitude": "-80.1918"
            },
            "geoRadius": "50000"
          },
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Endurance Testing Services",
            "itemListElement": [
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Lactate Threshold Test",
                  "description": "Determine personalized heart rate training zones 1-5 through scientific lactate analysis"
                },
                "price": "120",
                "priceCurrency": "USD"
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Sweat Test Analysis",
                  "description": "Measure sweat rate, sodium and potassium loss for optimal hydration strategies"
                },
                "price": "40",
                "priceCurrency": "USD"
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Combined Lactate + Sweat Test",
                  "description": "Complete physiological profiling with training zones and hydration optimization"
                },
                "price": "140",
                "priceCurrency": "USD"
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Personalized Coaching - Norwegian Method",
                  "description": "DNA and blood work-based training using Norwegian polarized training zones (LT1, LT2)"
                },
                "price": "200",
                "priceCurrency": "USD"
              }
            ]
          }
        },
        {
          "@type": "FAQPage",
          "@id": "https://miamiendurancetesting.com/#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "What are the 5 heart rate training zones?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Zone 1 (Recovery): 50-60% max HR - Easy aerobic base. Zone 2 (Aerobic): 60-70% - Fat burning, endurance building. Zone 3 (Tempo): 70-80% - Sustainable moderate effort. Zone 4 (Threshold/LT2): 80-90% - Lactate threshold, FTP/CP. Zone 5 (Anaerobic): 90-100% - Maximum effort, VO2max intervals."
              }
            },
            {
              "@type": "Question",
              "name": "What is the Norwegian training method?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "The Norwegian method is a polarized training approach using 80/20 intensity distribution: 80% low intensity (Zone 1-2 below LT1) and 20% high intensity (Zone 4-5 above LT2). It emphasizes double threshold days, focusing on lactate threshold intervals to maximize aerobic capacity without excessive fatigue."
              }
            },
            {
              "@type": "Question",
              "name": "What is the difference between LT1 and LT2?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "LT1 (Aerobic Threshold) is where lactate first rises above baseline - marks upper limit of pure aerobic metabolism. LT2 (Lactate Threshold/Anaerobic Threshold) is where lactate accumulates faster than clearance - sustainable max effort for 30-60 minutes. LT2 typically corresponds to FTP (cycling) or threshold running pace."
              }
            }
          ]
        }
      ]
    }
    </script>
    
