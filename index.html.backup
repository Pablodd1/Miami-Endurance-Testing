                <!-- FAQ Category 4: General Questions -->
                <div class="faq-category">
                    <h3 class="category-title"><i class="fas fa-question-circle"></i> General Questions</h3>
                    
                    <div class="faq-item">
                        <button class="faq-question" aria-expanded="false">
                            <span>Who can benefit from lactate testing?</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <div class="faq-answer">
                            <div class="beneficiaries">
                                <h4>Anyone training with purpose can benefit:</h4>
                                <div class="beneficiary-grid">
                                    <div class="beneficiary">
                                        <i class="fas fa-running"></i>
                                        <h5>Runners</h5>
                                        <p>5K to ultra-marathon. Determine threshold pace, optimal long run pace, and interval targets.</p>
                                    </div>
                                    <div class="beneficiary">
                                        <i class="fas fa-bicycle"></i>
                                        <h5>Cyclists</h5>
                                        <p>Road, MTB, gravel. Find FTP/CP, set power zones, structure interval workouts.</p>
                                    </div>
                                    <div class="beneficiary">
                                        <i class="fas fa-swimmer"></i>
                                        <h5>Triathletes</h5>
                                        <p>Essential for managing fatigue across three sports. Optimize training distribution.</p>
                                    </div>
                                    <div class="beneficiary">
                                        <i class="fas fa-dumbbell"></i>
                                        <h5>CrossFit/HIIT</h5>
                                        <p>Understand work capacity, optimize metcon pacing, improve conditioning.</p>
                                    </div>
                                    <div class="beneficiary">
                                        <i class="fas fa-user-friends"></i>
                                        <h5>Beginners</h5>
                                        <p>Learn to train by feel with data backup. Prevent overtraining early.</p>
                                    </div>
