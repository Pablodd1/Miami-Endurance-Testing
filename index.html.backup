    <!-- ===== COMPREHENSIVE FAQ SECTION WITH TRAINING ZONES & NORWEGIAN METHOD ===== -->
    <section id="faq" class="faq-section">
        <div class="container">
            <h2 class="section-title">FREQUENTLY ASKED QUESTIONS</h2>
            <p class="section-subtitle">Everything you need to know about training zones, lactate testing & the Norwegian method</p>
            
            <div class="faq-grid">
                <!-- FAQ Category 1: Training Zones -->
                <div class="faq-category">
                    <h3 class="category-title"><i class="fas fa-heart-pulse"></i> Understanding Training Zones 1-5</h3>
                    
                    <div class="faq-item">
                        <button class="faq-question" aria-expanded="false">
                            <span>What are the 5 heart rate training zones and how do they work?</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <div class="faq-answer">
                            <p>The 5-zone model is based on your lactate threshold and maximum heart rate. Each zone trains different energy systems:</p>
                            
                            <!-- Visual Zone Diagram -->
                            <div class="zone-visualization">
                                <svg viewBox="0 0 800 300" class="zone-diagram">
                                    <!-- Background -->
                                    <rect x="0" y="0" width="800" height="300" fill="#f8f9fa" rx="10"/>
                                    
                                    <!-- Zone 1: Recovery (Blue) -->
                                    <rect x="50" y="50" width="140" height="200" fill="#3498db" rx="8" opacity="0.9"/>
                                    <text x="120" y="80" text-anchor="middle" fill="white" font-size="14" font-weight="bold">ZONE 1</text>
                                    <text x="120" y="105" text-anchor="middle" fill="white" font-size="11">Recovery</text>
                                    <text x="120" y="140" text-anchor="middle" fill="white" font-size="12">50-60% Max HR</text>
                                    <text x="120" y="165" text-anchor="middle" fill="white" font-size="10">Aerobic Base</text>
                                    <text x="120" y="190" text-anchor="middle" fill="white" font-size="10">Fat Burning</text>
                                    
                                    <!-- Zone 2: Aerobic (Green) -->
                                    <rect x="195" y="50" width="140" height="200" fill="#2ecc71" rx="8" opacity="0.9"/>
                                    <text x="265" y="80" text-anchor="middle" fill="white" font-size="14" font-weight="bold">ZONE 2</text>
                                    <text x="265" y="105" text-anchor="middle" fill="white" font-size="11">Aerobic</text>
                                    <text x="265" y="140" text-anchor="middle" fill="white" font-size="12">60-70% Max HR</text>
                                    <text x="265" y="165" text-anchor="middle" fill="white" font-size="10">Endurance</text>
                                    <text x="265" y="190" text-anchor="middle" fill="white" font-size="10">Marathon Pace</text>
                                    
                                    <!-- Zone 3: Tempo (Yellow) -->
                                    <rect x="340" y="50" width="140" height="200" fill="#f1c40f" rx="8" opacity="0.9"/>
                                    <text x="410" y="80" text-anchor="middle" fill="#333" font-size="14" font-weight="bold">ZONE 3</text>
                                    <text x="410" y="105" text-anchor="middle" fill="#333" font-size="11">Tempo</text>
                                    <text x="410" y="140" text-anchor="middle" fill="#333" font-size="12">70-80% Max HR</text>
                                    <text x="410" y="165" text-anchor="middle" fill="#333" font-size="10">Sweet Spot</text>
                                    <text x="410" y="190" text-anchor="middle" fill="#333" font-size="10">Moderate Effort</text>
                                    
                                    <!-- Zone 4: Threshold (Orange) -->
                                    <rect x="485" y="50" width="140" height="200" fill="#ff6b35" rx="8" opacity="0.9"/>
                                    <text x="555" y="80" text-anchor="middle" fill="white" font-size="14" font-weight="bold">ZONE 4</text>
                                    <text x="555" y="105" text-anchor="middle" fill="white" font-size="11">Threshold / LT2</text>
                                    <text x="555" y="140" text-anchor="middle" fill="white" font-size="12">80-90% Max HR</text>
                                    <text x="555" y="165" text-anchor="middle" fill="white" font-size="10">FTP / CP / Lactate</text>
                                    <text x="555" y="190" text-anchor="middle" fill="white" font-size="10">30-60 min max</text>
                                    
                                    <!-- Zone 5: Anaerobic (Red) -->
                                    <rect x="630" y="50" width="140" height="200" fill="#e74c3c" rx="8" opacity="0.9"/>
                                    <text x="700" y="80" text-anchor="middle" fill="white" font-size="14" font-weight="bold">ZONE 5</text>
                                    <text x="700" y="105" text-anchor="middle" fill="white" font-size="11">VO2max / Anaerobic</text>
                                    <text x="700" y="140" text-anchor="middle" fill="white" font-size="12">90-100% Max HR</text>
                                    <text x="700" y="165" text-anchor="middle" fill="white" font-size="10">High Intensity</text>
                                    <text x="700" y="190" text-anchor="middle" fill="white" font-size="10">2-8 min intervals</text>
                                </svg>
                            </div>
                            
                            <div class="zone-details">
                                <div class="zone-card zone-1">
                                    <h4><span class="zone-badge blue">Zone 1</span> Recovery / Active Recovery</h4>
                                    <ul>
                                        <li><strong>Intensity:</strong> 50-60% of Max HR or <60% of Lactate Threshold (LT2)</li>
                                        <li><strong>Feel:</strong> Easy conversation pace, nose breathing possible</li>
                                        <li><strong>Energy System:</strong> Pure aerobic, primarily fat metabolism</li>
                                        <li><strong>Training Purpose:</strong> Recovery between hard sessions, building aerobic base</li>
                                        <li><strong>Duration:</strong> 30-120 minutes</li>
                                        <li><strong>Physiological Effect:</strong> Increases capillary density, mitochondrial biogenesis</li>
                                    </ul>
                                </div>
                                
                                <div class="zone-card zone-2">
                                    <h4><span class="zone-badge green">Zone 2</span> Aerobic / Endurance</h4>
                                    <ul>
                                        <li><strong>Intensity:</strong> 60-70% of Max HR or 60-75% of LT2</li>
                                        <li><strong>Feel:</strong> Comfortable, steady breathing, can hold conversation</li>
                                        <li><strong>Energy System:</strong> Aerobic, mix of fat and carbohydrate</li>
                                        <li><strong>Training Purpose:</strong> Build aerobic capacity, marathon pace</li>
                                        <li><strong>Duration:</strong> 45 minutes to 3+ hours</li>
                                        <li><strong>Physiological Effect:</strong> Improves fat oxidation, increases stroke volume</li>
                                        <li><strong>Key Point:</strong> This is below LT1 (aerobic threshold)</li>
                                    </ul>
                                </div>
                                
                                <div class="zone-card zone-3">
                                    <h4><span class="zone-badge yellow">Zone 3</span> Tempo / Sweet Spot</h4>
                                    <ul>
                                        <li><strong>Intensity:</strong> 70-80% of Max HR or 75-90% of LT2</li>
                                        <li><strong>Feel:</strong> Moderately hard, conversation becomes difficult</li>
                                        <li><strong>Energy System:</strong> Aerobic with increasing anaerobic contribution</li>
                                        <li><strong>Training Purpose:</strong> Sustainable race pace, time trial efforts</li>
                                        <li><strong>Duration:</strong> 20-60 minutes continuous or intervals</li>
                                        <li><strong>Physiological Effect:</strong> Improves lactate clearance, muscular endurance</li>
                                        <li><strong>Note:</strong> Many coaches minimize time in this zone</li>
                                    </ul>
                                </div>
                                
                                <div class="zone-card zone-4">
                                    <h4><span class="zone-badge orange">Zone 4</span> Threshold / LT2 / FTP</h4>
                                    <ul>
                                        <li><strong>Intensity:</strong> 80-90% of Max HR or 95-105% of LT2</li>
                                        <li><strong>Feel:</strong> Hard, breathing labored, conversation impossible</li>
                                        <li><strong>Energy System:</strong> High anaerobic contribution, lactate accumulation</li>
                                        <li><strong>Training Purpose:</strong> Race pace for 30-60 min events, intervals</li>
                                        <li><strong>Duration:</strong> 10-40 minute efforts or 2x20min, 4x10min intervals</li>
                                        <li><strong>Physiological Effect:</strong> Increases lactate threshold, VO2max</li>
                                        <li><strong>Also Called:</strong> Functional Threshold Power (FTP) in cycling</li>
                                    </ul>
                                </div>
                                
                                <div class="zone-card zone-5">
                                    <h4><span class="zone-badge red">Zone 5</span> VO2max / Anaerobic</h4>
                                    <ul>
                                        <li><strong>Intensity:</strong> 90-100% of Max HR or 105-120% of LT2</li>
                                        <li><strong>Feel:</strong> Very hard to maximum, unsustainable for long</li>
                                        <li><strong>Energy System:</strong> Anaerobic glycolysis, high lactate</li>
                                        <li><strong>Training Purpose:</strong> Peak power, sprints, VO2max intervals</li>
                                        <li><strong>Duration:</strong> 30 seconds to 8 minutes (intervals)</li>
                                        <li><strong>Physiological Effect:</strong> Increases VO2max, anaerobic capacity</li>
                                        <li><strong>Sub-zones:</strong> 5a (3-8min), 5b (1-3min), 5c (<1min)</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="faq-item">
                        <button class="faq-question" aria-expanded="false">
                            <span>What is LT1 vs LT2 and why does it matter for my training?</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <div class="faq-answer">
                            <p>LT1 and LT2 are your two critical lactate thresholds that define your training zones:</p>
                            
                            <!-- LT1 vs LT2 Diagram -->
                            <div class="lt-diagram">
                                <svg viewBox="0 0 700 350" class="zone-diagram">
                                    <!-- Background -->
                                    <rect x="0" y="0" width="700" height="350" fill="#f8f9fa" rx="10"/>
                                    
                                    <!-- Title -->
                                    <text x="350" y="30" text-anchor="middle" font-size="16" font-weight="bold" fill="#333">Lactate Curve & Training Thresholds</text>
                                    
                                    <!-- Grid lines -->
                                    <line x1="80" y1="60" x2="80" y2="300" stroke="#ddd" stroke-width="1"/>
                                    <line x1="80" y1="300" x2="650" y2="300" stroke="#ddd" stroke-width="1"/>
                                    
                                    <!-- Y-axis labels -->
                                    <text x="70" y="70" text-anchor="end" font-size="10" fill="#666">6.0</text>
                                    <text x="70" y="120" text-anchor="end" font-size="10" fill="#666">4.5</text>
                                    <text x="70" y="170" text-anchor="end" font-size="10" fill="#666">3.0</text>
                                    <text x="70" y="220" text-anchor="end" font-size="10" fill="#666">1.5</text>
                                    <text x="70" y="285" text-anchor="end" font-size="10" fill="#666">0</text>
                                    <text x="40" y="180" text-anchor="middle" font-size="11" fill="#666" transform="rotate(-90 40 180)">Blood Lactate (mmol/L)</text>
                                    
                                    <!-- X-axis labels -->
                                    <text x="80" y="320" text-anchor="middle" font-size="10" fill="#666">Rest</text>
                                    <text x="220" y="320" text-anchor="middle" font-size="10" fill="#666">Easy</text>
                                    <text x="360" y="320" text-anchor="middle" font-size="10" fill="#666">Moderate</text>
                                    <text x="500" y="320" text-anchor="middle" font-size="10" fill="#666">Hard</text>
                                    <text x="620" y="320" text-anchor="middle" font-size="10" fill="#666">Max</text>
                                    <text x="365" y="340" text-anchor="middle" font-size="11" fill="#666">Exercise Intensity →</text>
                                    
                                    <!-- Lactate curve -->
                                    <path d="M 80 280 Q 150 275 220 260 Q 290 240 360 200 Q 430 150 500 100 Q 570 65 620 60" 
                                          fill="none" stroke="#e74c3c" stroke-width="3"/>
                                    
                                    <!-- Baseline -->
                                    <line x1="80" y1="275" x2="200" y2="265" stroke="#3498db" stroke-width="2" stroke-dasharray="5,5"/>
                                    
                                    <!-- LT1 Point -->
                                    <circle cx="290" cy="240" r="6" fill="#3498db"/>
                                    <line x1="290" y1="240" x2="290" y2="300" stroke="#3498db" stroke-width="2" stroke-dasharray="3,3"/>
                                    <text x="290" y="315" text-anchor="middle" font-size="10" fill="#3498db" font-weight="bold">LT1</text>
                                    <text x="220" y="230" text-anchor="middle" font-size="9" fill="#3498db">Aerobic</text>
                                    <text x="220" y="242" text-anchor="middle" font-size="9" fill="#3498db">Threshold</text>
                                    
                                    <!-- LT2 Point -->
                                    <circle cx="500" cy="100" r="6" fill="#ff6b35"/>
                                    <line x1="500" y1="100" x2="500" y2="300" stroke="#ff6b35" stroke-width="2" stroke-dasharray="3,3"/>
                                    <text x="500" y="315" text-anchor="middle" font-size="10" fill="#ff6b35" font-weight="bold">LT2</text>
                                    <text x="580" y="130" text-anchor="middle" font-size="9" fill="#ff6b35">Lactate/Anaerobic</text>
                                    <text x="580" y="142" text-anchor="middle" font-size="9" fill="#ff6b35">Threshold</text>
                                    
                                    <!-- Zone labels -->
                                    <rect x="100" y="85" width="100" height="25" fill="#2ecc71" rx="5" opacity="0.8"/>
                                    <text x="150" y="102" text-anchor="middle" font-size="10" fill="white" font-weight="bold">Zone 1-2</text>
                                    
                                    <rect x="310" y="85" width="100" height="25" fill="#f1c40f" rx="5" opacity="0.8"/>
                                    <text x="360" y="102" text-anchor="middle" font-size="10" fill="#333" font-weight="bold">Zone 3</text>
                                    
                                    <rect x="520" y="85" width="100" height="25" fill="#ff6b35" rx="5" opacity="0.8"/>
                                    <text x="570" y="102" text-anchor="middle" font-size="10" fill="white" font-weight="bold">Zone 4-5</text>
                                </svg>
                            </div>
                            
                            <div class="threshold-comparison">
                                <div class="threshold-box lt1-box">
                                    <h4><span class="threshold-icon">📉</span> LT1 - Aerobic Threshold (First Threshold)</h4>
                                    <div class="threshold-content">
                                        <p><strong>Definition:</strong> The exercise intensity where blood lactate first rises above resting baseline (typically ~1.5-2.0 mmol/L increase)</p>
                                        <ul>
                                            <li><strong>Heart Rate:</strong> Usually 70-75% of max HR</li>
                                            <li><strong>Power/Pace:</strong> Easy endurance pace, can maintain for hours</li>
                                            <li><strong>Feel:</strong> Comfortable conversation pace, nose breathing possible</li>
                                            <li><strong>Fuel:</strong> Predominantly fat oxidation</li>
                                            <li><strong>Training Zone:</strong> Upper limit of Zone 2</li>
                                        </ul>
                                        <div class="threshold-importance">
                                            <strong>Why it matters:</strong> Training below LT1 improves fat burning efficiency and aerobic base without accumulating lactate. Many elite athletes do 80% of training below LT1.
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="threshold-box lt2-box">
                                    <h4><span class="threshold-icon">📈</span> LT2 - Lactate Threshold (Second Threshold / AnT / FTP)</h4>
                                    <div class="threshold-content">
                                        <p><strong>Definition:</strong> The intensity where lactate accumulates faster than clearance (typically 4.0 mmol/L or individual inflection point)</p>
                                        <ul>
                                            <li><strong>Heart Rate:</strong> Usually 85-90% of max HR</li>
                                            <li><strong>Power/Pace:</strong> Maximum sustainable for 30-60 minutes (FTP/CP)</li>
                                            <li><strong>Feel:</strong> Hard effort, breathing labored, conversation difficult</li>
                                            <li><strong>Fuel:</strong> High carbohydrate usage, lactate production</li>
                                            <li><strong>Training Zone:</strong> Lower Zone 4</li>
                                        </ul>
                                        <div class="threshold-importance">
                                            <strong>Why it matters:</strong> LT2 determines your sustainable race pace for time trials, triathlons, and marathons. It's your "red line" - go above it and you'll fatigue quickly.
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="coach-note">
                                <h5><i class="fas fa-lightbulb"></i> Coach's Interpretation Note:</h5>
                                <p>Every athlete has unique LT1 and LT2 values! A good coach doesn't just give you numbers - they interpret:</p>
                                <ul>
                                    <li><strong>The curve shape:</strong> Is it gradual or steep? (Indicates trainability)</li>
                                    <li><strong>LT1-LT2 gap:</strong> Wide gap = more Zone 2 training needed; Narrow gap = threshold work priority</li>
                                    <li><strong>Absolute values:</strong> High lactate at LT2 may indicate fast-twitch dominance</li>
                                    <li><strong>Recovery rate:</strong> How fast lactate clears between intervals</li>
                                    <li><strong>Individual variation:</strong> Some athletes perform best at 3.5 mmol, others at 5.0 mmol</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <div class="faq-item">
                        <button class="faq-question" aria-expanded="false">
                            <span>How do I know which zone I should train in for my goal?</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <div class="faq-answer">
                            <div class="training-by-goal">
                                <div class="goal-card">
                                    <h4><i class="fas fa-road"></i> Marathon / Long Distance</h4>
                                    <div class="goal-zones">
                                        <span class="zone-tag green">Zone 2: 70%</span>
                                        <span class="zone-tag orange">Zone 4: 20%</span>
                                        <span class="zone-tag red">Zone 5: 10%</span>
                                    </div>
                                    <p>Build massive aerobic base with long Zone 2 runs. Threshold intervals improve marathon pace sustainability. Minimal Zone 3 to avoid "junk miles."</p>
                                </div>
                                
                                <div class="goal-card">
                                    <h4><i class="fas fa-stopwatch"></i> 5K / 10K / Half Marathon</h4>
                                    <div class="goal-zones">
                                        <span class="zone-tag green">Zone 2: 60%</span>
                                        <span class="zone-tag yellow">Zone 3: 15%</span>
                                        <span class="zone-tag orange">Zone 4: 20%</span>
                                        <span class="zone-tag red">Zone 5: 5%</span>
                                    </div>
                                    <p>Balance aerobic base with more threshold and tempo work. Zone 4 intervals at LT2 pace are critical.</p>
                                </div>
                                
                                <div class="goal-card">
                                    <h4><i class="fas fa-bicycle"></i> Cycling FTP Improvement</h4>
                                    <div class="goal-zones">
                                        <span class="zone-tag green">Zone 2: 65%</span>
                                        <span class="zone-tag orange">Zone 4: 25%</span>
                                        <span class="zone-tag red">Zone 5: 10%</span>
                                    </div>
                                    <p>Sweet spot (upper Zone 3) and threshold (Zone 4) work raises FTP. VO2max intervals boost ceiling.</p>
                                </div>
                                
                                <div class="goal-card">
                                    <h4><i class="fas fa-medal"></i> Triathlon (Olympic/Ironman)</h4>
                                    <div class="goal-zones">
                                        <span class="zone-tag blue">Zone 1: 10%</span>
                                        <span class="zone-tag green">Zone 2: 70%</span>
                                        <span class="zone-tag orange">Zone 4: 20%</span>
                                    </div>
                                    <p>Follow Norwegian 80/20 method. Massive Zone 1-2 volume with polarized high-intensity intervals.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- FAQ Category 2: Norwegian Method -->
                <div class="faq-category">
                    <h3 class="category-title"><i class="fas fa-mountain"></i> The Norwegian Training Method</h3>
                    
                    <div class="faq-item">
                        <button class="faq-question" aria-expanded="false">
                            <span>What is the Norwegian method and why are elite athletes using it?</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <div class="faq-answer">
                            <div class="norwegian-intro">
                                <p>The <strong>Norwegian training method</strong> (also called "polarized training" or the "80/20 rule") is a scientifically-backed approach that has produced multiple Olympic champions, world record holders, and Ironman winners from Norway and beyond.</p>
                            </div>
                            
                            <!-- Norwegian Method Visual -->
                            <div class="norwegian-diagram">
                                <svg viewBox="0 0 700 400" class="zone-diagram">
                                    <rect x="0" y="0" width="700" height="400" fill="#f8f9fa" rx="10"/>
                                    
                                    <!-- Title -->
                                    <text x="350" y="30" text-anchor="middle" font-size="18" font-weight="bold" fill="#004e89">The Norwegian 80/20 Polarized Model</text>
                                    
                                    <!-- 80% Low Intensity Section -->
                                    <rect x="50" y="60" width="440" height="150" fill="#2ecc71" rx="10" opacity="0.9"/>
                                    <text x="270" y="100" text-anchor="middle" fill="white" font-size="48" font-weight="bold">80%</text>
                                    <text x="270" y="130" text-anchor="middle" fill="white" font-size="14">Low Intensity</text>
                                    <text x="270" y="155" text-anchor="middle" fill="white" font-size="12">Zone 1 (Recovery) + Zone 2 (Endurance)</text>
                                    <text x="270" y="175" text-anchor="middle" fill="rgba(255,255,255,0.9)" font-size="11">Below LT1 - Aerobic Base Building</text>
                                    
                                    <!-- Arrow -->
                                    <path d="M 510 135 L 560 135" stroke="#666" stroke-width="2" marker-end="url(#arrowhead)"/>
                                    <defs>
                                        <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
                                            <polygon points="0 0, 10 3.5, 0 7" fill="#666"/>
                                        </marker>
                                    </defs>
                                    
                                    <!-- 20% High Intensity Section -->
                                    <rect x="50" y="230" width="110" height="150" fill="#f1c40f" rx="10" opacity="0.9"/>
                                    <text x="105" y="270" text-anchor="middle" fill="#333" font-size="20" font-weight="bold">~0%</text>
                                    <text x="105" y="290" text-anchor="middle" fill="#333" font-size="10">Zone 3</text>
                                    <text x="105" y="310" text-anchor="middle" fill="#666" font-size="9">Avoid</text>
                                    
                                    <rect x="175" y="230" width="165" height="150" fill="#ff6b35" rx="10" opacity="0.9"/>
                                    <text x="257" y="270" text-anchor="middle" fill="white" font-size="20" font-weight="bold">10%</text>
                                    <text x="257" y="290" text-anchor="middle" fill="white" font-size="10">Zone 4</text>
                                    <text x="257" y="310" text-anchor="middle" fill="rgba(255,255,255,0.9)" font-size="9">LT2 / Threshold</text>
                                    
                                    <rect x="355" y="230" width="135" height="150" fill="#e74c3c" rx="10" opacity="0.9"/>
                                    <text x="422" y="270" text-anchor="middle" fill="white" font-size="20" font-weight="bold">10%</text>
                                    <text x="422" y="290" text-anchor="middle" fill="white" font-size="10">Zone 5</text>
                                    <text x="422" y="310" text-anchor="middle" fill="rgba(255,255,255,0.9)" font-size="9">VO2max / Sprint</text>
                                    
                                    <!-- Key principles -->
                                    <rect x="510" y="70" width="170" height="310" fill="#004e89" rx="10"/>
                                    <text x="595" y="100" text-anchor="middle" fill="#ff6b35" font-size="14" font-weight="bold">Key Principles</text>
                                    
                                    <text x="525" y="135" fill="white" font-size="11">• Keep easy days EASY</text>
                                    <text x="525" y="160" fill="white" font-size="11">• Make hard days HARD</text>
                                    <text x="525" y="185" fill="white" font-size="11">• Avoid "gray zone"</text>
                                    <text x="525" y="210" fill="white" font-size="11">• Double threshold days</text>
                                    <text x="525" y="235" fill="white" font-size="11">• High volume overall</text>
                                    
                                    <text x="595" y="280" text-anchor="middle" fill="#ff6b35" font-size="12" font-weight="bold">Results:</text>
                                    <text x="525" y="305" fill="white" font-size="10">✓ Less fatigue</text>
                                    <text x="525" y="325" fill="white" font-size="10">✓ Better recovery</text>
                                    <text x="525" y="345" fill="white" font-size="10">✓ Higher performance</text>
                                    <text x="525" y="365" fill="white" font-size="10">✓ Injury prevention</text>
                                </svg>
                            </div>
                            
                            <div class="norwegian-principles">
                                <h4>Core Principles of the Norwegian Method:</h4>
                                <div class="principle-grid">
                                    <div class="principle-card">
                                        <h5><span class="principle-number">1</span> 80/20 Intensity Distribution</h5>
                                        <p>Spend 80% of training time at low intensity (below LT1) and 20% at high intensity (above LT2). Virtually no training in Zone 3 (the "gray zone" or "junk miles").</p>
                                    </div>
                                    
                                    <div class="principle-card">
                                        <h5><span class="principle-number">2</span> Double Threshold Days</h5>
                                        <p>Elite Norwegian athletes often do TWO threshold sessions per day (morning and evening), accumulating high-quality Zone 4 volume without excessive stress.</p>
                                    </div>
                                    
                                    <div class="principle-card">
                                        <h5><span class="principle-number">3</span> Lactate-Guided Training</h5>
                                        <p>Using frequent lactate testing to ensure they're training in correct zones. If lactate drifts too high during "easy" sessions, intensity is reduced.</p>
                                    </div>
                                    
                                    <div class="principle-card">
                                        <h5><span class="principle-number">4</span> Polarized Approach</h5>
                                        <p>Clear separation between easy (Zone 1-2) and hard (Zone 4-5). No "moderately hard" training that creates fatigue without sufficient stimulus.</p>
                                    </div>
                                    
                                    <div class="principle-card">
                                        <h5><span class="principle-number">5</span> High Volume, Low Stress</h5>
                                        <p>20-30+ hours/week for elites, but 80% is conversational pace. This builds massive aerobic capacity without burnout.</p>
                                    </div>
                                    
                                    <div class="principle-card">
                                        <h5><span class="principle-number">6</span> Individual Threshold Monitoring</h5>
                                        <p>Regular lactate testing (every 4-6 weeks) to track progress and adjust zones. Thresholds change as fitness improves!</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="norwegian-example">
                                <h4><i class="fas fa-running"></i> Example Norwegian Method Week (Elite Triathlete):</h4>
                                <div class="week-schedule">
                                    <div class="day-row">
                                        <span class="day">Monday</span>
                                        <span class="sessions">
                                            <span class="session easy">AM: 90min Zone 2 run</span>
                                            <span class="session hard">PM: 5x10min @ LT2 (Zone 4) bike</span>
                                        </span>
                                    </div>
                                    <div class="day-row">
                                        <span class="day">Tuesday</span>
                                        <span class="sessions">
                                            <span class="session easy">AM: 60min Zone 2 swim</span>
                                            <span class="session easy">PM: 120min Zone 2 bike</span>
                                        </span>
                                    </div>
                                    <div class="day-row">
                                        <span class="day">Wednesday</span>
                                        <span class="sessions">
                                            <span class="session hard">AM: 8x5min @ LT2 run intervals</span>
                                            <span class="session hard">PM: 6x8min @ LT2 bike intervals</span>
                                        </span>
                                    </div>
                                    <div class="day-row">
                                        <span class="day">Thursday</span>
                                        <span class="sessions">
                                            <span class="session easy">AM: 90min Zone 2 run</span>
                                            <span class="session easy">PM: 90min Zone 2 swim</span>
                                        </span>
                                    </div>
                                    <div class="day-row">
                                        <span class="day">Friday</span>
                                        <span class="sessions">
                                            <span class="session rest">REST or 30min Zone 1 recovery</span>
                                        </span>
                                    </div>
                                    <div class="day-row">
                                        <span class="day">Saturday</span>
                                        <span class="sessions">
                                            <span class="session hard">Long brick: 3hr Zone 2-3 bike + 45min Zone 4 run</span>
                                        </span>
                                    </div>
                                    <div class="day-row">
                                        <span class="day">Sunday</span>
                                        <span class="sessions">
                                            <span class="session easy">3hr Zone 2 long run</span>
                                        </span>
                                    </div>
                                </div>
                                <p class="week-total"><strong>Weekly Total:</strong> ~20-25 hours | <strong>Zone 1-2:</strong> 80% | <strong>Zone 4-5:</strong> 20% | <strong>Zone 3:</strong> &lt;5%</p>
                            </div>
                            
                            <div class="norwegian-science">
                                <h4><i class="fas fa-microscope"></i> The Science Behind Norwegian Success:</h4>
                                <ul>
                                    <li><strong>Study (Stöggl & Sperlich, 2014):</strong> Polarized training improved VO2max by 11.7% vs 4.8% for threshold-focused training</li>
                                    <li><strong>Ingebrigtsen Brothers:</strong> Multiple Olympic medals using strict 80/20 approach with lactate monitoring</li>
                                    <li><strong>Gustav Iden (Ironman World Champ):</strong> Trains 30+ hours/week, 80% below LT1, double threshold days</li>
                                    <li><strong>Research:</strong> Zone 3 creates "interference effect" - too hard for recovery, too easy for adaptation</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <div class="faq-item">
                        <button class="faq-question" aria-expanded="false">
                            <span>What's the "gray zone" and why should I avoid it?</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <div class="faq-answer">
                            <div class="gray-zone-explanation">
                                <p>The <strong>"gray zone"</strong> (also called "junk miles" or "Zone 3 purgatory") is training at a moderate intensity that's too hard for proper aerobic development but too easy for high-intensity adaptation.</p>
                                
                                <div class="gray-zone-visual">
                                    <svg viewBox="0 0 600 200" class="zone-diagram">
                                        <rect x="0" y="0" width="600" height="200" fill="#f8f9fa" rx="10"/>
                                        
                                        <!-- Zones -->
                                        <rect x="50" y="60" width="120" height="100" fill="#2ecc71" rx="5"/>
                                        <text x="110" y="95" text-anchor="middle" fill="white" font-size="12" font-weight="bold">Zone 1-2</text>
                                        <text x="110" y="115" text-anchor="middle" fill="white" font-size="10">GOOD ✓</text>
                                        <text x="110" y="135" text-anchor="middle" fill="white" font-size="9">Builds base</text>
                                        
                                        <rect x="190" y="60" width="120" height="100" fill="#95a5a6" rx="5"/>
                                        <text x="250" y="85" text-anchor="middle" fill="white" font-size="12" font-weight="bold">Zone 3</text>
                                        <text x="250" y="108" text-anchor="middle" fill="#e74c3c" font-size="14" font-weight="bold">GRAY ZONE</text>
                                        <text x="250" y="130" text-anchor="middle" fill="white" font-size="9">AVOID ✗</text>
                                        <text x="250" y="145" text-anchor="middle" fill="white" font-size="8">Junk miles</text>
                                        
                                        <rect x="330" y="60" width="110" height="100" fill="#ff6b35" rx="5"/>
                                        <text x="385" y="95" text-anchor="middle" fill="white" font-size="12" font-weight="bold">Zone 4</text>
                                        <text x="385" y="115" text-anchor="middle" fill="white" font-size="10">GOOD ✓</text>
                                        <text x="385" y="135" text-anchor="middle" fill="white" font-size="9">Threshold</text>
                                        
                                        <rect x="460" y="60" width="100" height="100" fill="#e74c3c" rx="5"/>
                                        <text x="510" y="95" text-anchor="middle" fill="white" font-size="12" font-weight="bold">Zone 5</text>
                                        <text x="510" y="115" text-anchor="middle" fill="white" font-size="10">GOOD ✓</text>
                                        <text x="510" y="135" text-anchor="middle" fill="white" font-size="9">VO2max</text>
                                        
                                        <!-- Labels -->
                                        <text x="110" y="180" text-anchor="middle" font-size="10" fill="#2ecc71">Low Stress</text>
                                        <text x="385" y="180" text-anchor="middle" font-size="10" fill="#ff6b35">High Stress</text>
                                        <text x="510" y="180" text-anchor="middle" font-size="10" fill="#e74c3c">Max Stress</text>
                                        
                                        <!-- Warning -->
                                        <text x="250" y="40" text-anchor="middle" font-size="11" fill="#e74c3c" font-weight="bold">⚠️ Too hard to recover, too easy to adapt</text>
                                    </svg>
                                </div>
                                
                                <div class="gray-zone-problems">
                                    <h5>Problems with Gray Zone Training:</h5>
                                    <div class="problem-grid">
                                        <div class="problem-item">
                                            <span class="problem-icon">😴</span>
                                            <h6>Insufficient Recovery</h6>
                                            <p>Creates too much fatigue for next hard session</p>
                                        </div>
                                        <div class="problem-item">
                                            <span class="problem-icon">📉</span>
                                            <h6>Poor Adaptation</h6>
                                            <p>Not hard enough to stimulate VO2max or threshold improvements</p>
                                        </div>
                                        <div class="problem-item">
                                            <span class="problem-icon">⏱️</span>
                                            <h6>Time Inefficient</h6>
                                            <p>Same time investment, less physiological return</p>
                                        </div>
                                        <div class="problem-item">
                                            <span class="problem-icon">🤕</span>
                                            <h6>Injury Risk</h6>
                                            <p>Accumulated fatigue increases overuse injury risk</p>
                                        </div>
                                        <div class="problem-item">
                                            <span class="problem-icon">😤</span>
                                            <h6>Stagnation</h6>
                                            <p>Chronic gray zone training leads to performance plateaus</p>
                                        </div>
                                        <div class="problem-item">
                                            <span class="problem-icon">🧠</span>
                                            <h6>Mental Burnout</h6>
                                            <p>Constant "moderately hard" effort is mentally draining</p>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="gray-zone-solution">
                                    <h5><i class="fas fa-check-circle"></i> The Solution: Polarize Your Training</h5>
                                    <ul>
                                        <li><strong>Easy days:</strong> Truly easy (Zone 1-2, can hold conversation)</li>
                                        <li><strong>Hard days:</strong> Truly hard (Zone 4-5, breathing hard, focused)</li>
                                        <li><strong>Avoid:</strong> The middle ground where you're working but not adapting</li>
                                        <li><strong>Monitor:</strong> Use lactate testing to confirm you're in right zones</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="faq-item">
                        <button class="faq-question" aria-expanded="false">
                            <span>How often should I test my lactate thresholds?</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <div class="faq-answer">
                            <div class="testing-schedule">
                                <h4>Recommended Testing Frequency:</h4>
                                <div class="schedule-grid">
                                    <div class="schedule-card beginner">
                                        <h5><i class="fas fa-seedling"></i> Beginners / Base Building</h5>
                                        <div class="frequency">Every 8-12 weeks</div>
                                        <p>Focus on building consistency first. Test quarterly to track aerobic base development.</p>
                                    </div>
                                    <div class="schedule-card intermediate">
                                        <h5><i class="fas fa-chart-line"></i> Intermediate / Building Phase</h5>
                                        <div class="frequency">Every 6-8 weeks</div>
                                        <p>Fitness changes faster during build phases. Bi-monthly testing ensures zones stay accurate.</p>
                                    </div>
                                    <div class="schedule-card advanced">
                                        <h5><i class="fas fa-trophy"></i> Advanced / Race Prep</h5>
                                        <div class="frequency">Every 4-6 weeks</div>
                                        <p>High training loads change thresholds rapidly. Monthly testing during race season.</p>
                                    </div>
                                    <div class="schedule-card elite">
                                        <h5><i class="fas fa-star"></i> Elite / Norwegian Method</h5>
                                        <div class="frequency">Every 2-4 weeks</div>
                                        <p>Elite athletes test frequently to maintain precise zone boundaries (some test weekly!)</p>
                                    </div>
                                </div>
                                
                                <div class="testing-triggers">
                                    <h5><i class="fas fa-bell"></i> Test Immediately If:</h5>
                                    <ul>
                                        <li>✓ You completed a major training block (6+ weeks)</li>
                                        <li>✓ You took 2+ weeks off (illness, vacation, injury)</li>
                                        <li>✓ Your race performance significantly improved or declined</li>
                                        <li>✓ Heart rate at usual pace has changed noticeably</li>
                                        <li>✓ You're starting a new training phase (base → build → peak)</li>
                                        <li>✓ You're switching sports (e.g., cycling focus to triathlon)</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- FAQ Category 3: Testing & Services -->
                <div class="faq-category">
                    <h3 class="category-title"><i class="fas fa-flask"></i> Our Testing Services</h3>
                    
                    <div class="faq-item">
                        <button class="faq-question" aria-expanded="false">
                            <span>What happens during a lactate threshold test?</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <div class="faq-answer">
                            <div class="test-process">
                                <h4>Your Lactate Threshold Test Experience:</h4>
                                <div class="process-steps">
                                    <div class="step">
                                        <div class="step-number">1</div>
                                        <h5>Pre-Test Preparation</h5>
                                        <ul>
                                            <li>No intense exercise 24 hours before</li>
                                            <li>Well-hydrated and rested</li>
                                            <li>Wear comfortable athletic clothing</li>
                                            <li>Bring your bike (for cycling test) or running shoes</li>
                                        </ul>
                                    </div>
                                    <div class="step">
                                        <div class="step-number">2</div>
                                        <h5>Warm-Up & Baseline</h5>
                                        <ul>
                                            <li>10-15 minute easy warm-up</li>
                                            <li>Resting lactate measurement (finger prick)</li>
                                            <li>Heart rate monitor setup</li>
                                            <li>Power meter or pace device calibration</li>
                                        </ul>
                                    </div>
                                    <div class="step">
                                        <div class="step-number">3</div>
                                        <h5>Progressive Test</h5>
                                        <ul>
                                            <li>Start at easy intensity (Zone 1)</li>
                                            <li>Increase every 3-4 minutes</li>
                                            <li>Lactate sample at each stage</li>
                                            <li>Record HR, power/pace, perceived effort</li>
                                            <li>Continue until exhaustion (8-12 stages)</li>
                                        </ul>
                                    </div>
                                    <div class="step">
                                        <div class="step-number">4</div>
                                        <h5>Data Analysis</h5>
                                        <ul>
                                            <li>Plot lactate vs. power/pace curve</li>
                                            <li>Identify LT1 and LT2 inflection points</li>
                                            <li>Calculate heart rate zones</li>
                                            <li>Determine FTP/CP (cycling) or threshold pace</li>
                                        </ul>
                                    </div>
                                    <div class="step">
                                        <div class="step-number">5</div>
                                        <h5>Consultation & Plan</h5>
                                        <ul>
                                            <li>Review your personalized results</li>
                                            <li>Explain your unique lactate curve</li>
                                            <li>Provide training zone prescription</li>
                                            <li>Discuss Norwegian method application</li>
                                            <li>Recommend testing frequency</li>
                                        </ul>
                                    </div>
                                </div>
                                
                                <div class="test-deliverables">
                                    <h5><i class="fas fa-file-medical-alt"></i> What You Receive:</h5>
                                    <ul class="deliverable-list">
                                        <li><i class="fas fa-check"></i> Detailed lactate curve graph</li>
