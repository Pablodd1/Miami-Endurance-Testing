                                <div class="coaching-components">
                                    <div class="component">
                                        <h5><i class="fas fa-dna"></i> Physiological Profiling</h5>
                                        <ul>
                                            <li>Complete lactate threshold testing (LT1, LT2)</li>
                                            <li>Sweat analysis for hydration optimization</li>
                                            <li>Review of DNA data (if available)</li>
                                            <li>Blood work analysis (metabolic markers)</li>
                                            <li>Heart Rate Variability (HRV) assessment</li>
                                            <li>Sleep quality evaluation</li>
                                        </ul>
                                    </div>
                                    <div class="component">
                                        <h5><i class="fas fa-calendar-alt"></i> Custom Training Plans</h5>
