            <!-- ===== TRAINING ZONE CALCULATOR ===== -->
            <div class="zone-calculator-section" id="zone-calculator">
                <h3 class="calculator-title"><i class="fas fa-calculator"></i> Training Zone Calculator</h3>
                <p class="calculator-intro">Enter your maximum heart rate to estimate your training zones. For accurate, personalized zones based on your lactate thresholds, book a professional test with us!</p>
                
                <div class="calculator-container">
                    <div class="calculator-inputs">
                        <div class="input-group">
                            <label for="max-hr">Maximum Heart Rate</label>
                            <input type="number" id="max-hr" placeholder="e.g., 185" min="120" max="220">
                            <small>bpm</small>
                        </div>
                        <div class="input-group">
                            <label for="resting-hr">Resting Heart Rate (Optional)</label>
                            <input type="number" id="resting-hr" placeholder="e.g., 55" min="30" max="100">
                            <small>bpm</small>
                        </div>
                    </div>
                    
                    <div class="calculator-results" id="calculator-results">
                        <h4>Your Estimated Training Zones</h4>
                        <div class="results-grid">
                            <div class="result-card zone1">
                                <span class="result-zone">Zone 1</span>
                                <span class="result-range" id="zone1-range">--</span>
                                <span class="result-label">Recovery</span>
                            </div>
                            <div class="result-card zone2">
                                <span class="result-zone">Zone 2</span>
                                <span class="result-range" id="zone2-range">--</span>
                                <span class="result-label">Aerobic</span>
                            </div>
                            <div class="result-card zone3">
                                <span class="result-zone">Zone 3</span>
                                <span class="result-range" id="zone3-range">--</span>
                                <span class="result-label">Tempo</span>
                            </div>
                            <div class="result-card zone4">
                                <span class="result-zone">Zone 4</span>
                                <span class="result-range" id="zone4-range">--</span>
                                <span class="result-label">Threshold</span>
                            </div>
                            <div class="result-card zone5">
                                <span class="result-zone">Zone 5</span>
                                <span class="result-range" id="zone5-range">--</span>
                                <span class="result-label">VO2max</span>
                            </div>
                        </div>
                        <div class="calculator-disclaimer">
                            <i class="fas fa-info-circle"></i>
                            <strong>Note:</strong> These are estimates based on maximum heart rate. For accurate, personalized training zones based on your lactate thresholds (LT1, LT2) and the Norwegian method, schedule a professional lactate threshold test with us.
                        </div>
                    </div>
                </div>
